{
	"schemaVersion": 1,
	"id": "theendupdate",
	"version": "${version}",
	"name": "The End Update",
	"description": "An expansion mod for The End dimension.",
	"authors": [
		"Ritro"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/ritro-the-end-update",
		"sources": "https://github.com/Ritro-0/Mod-TheEndUpdate"
	},
	"license": "MIT",
	"icon": "assets/theendupdate/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.theendupdate.TheEndUpdate"
		],
		"client": [
			"com.theendupdate.TheEndUpdateClient"
		]
	},
	"mixins": [
		"theendupdate.mixins.json",
		"theendupdate.client.mixins.json",
		"theendupdate.cow-client.mixins.json"
	],
	"custom": {
		"fabric-resource-loader-v0:resource_packs": [
			{
				"id": "theendupdate:default",
				"enabled_by_default": true
			}
		]
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}